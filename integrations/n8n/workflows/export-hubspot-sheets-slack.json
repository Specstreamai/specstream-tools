{
  "name": "SpecStream: send selected results to HubSpot, Sheets, or Slack",
  "active": false,
  "meta": {
    "gallery": false,
    "sequencer": false,
    "write_back_mode": "export-only"
  },
  "nodes": [
    {
      "id": "trigger",
      "name": "Request finished",
      "type": "n8n-nodes-specstream.specstreamTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "rows",
      "name": "Get results",
      "type": "n8n-nodes-specstream.specstream",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "parameters": {
        "operation": "getMatchingRows",
        "find_id": "={{$json.find_id}}"
      }
    },
    {
      "id": "hubspot",
      "name": "Send to HubSpot",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 1,
      "position": [
        480,
        -160
      ],
      "parameters": {
        "operation": "upsert",
        "export_only": true
      },
      "notes": "Creates contacts from published emails. No sequences."
    },
    {
      "id": "sheets",
      "name": "Send to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "operation": "append",
        "export_only": true
      }
    },
    {
      "id": "slack",
      "name": "Send to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [
        480,
        160
      ],
      "parameters": {
        "operation": "post",
        "export_only": true
      },
      "notes": "Posts the finished results to a channel."
    }
  ],
  "connections": {
    "Request finished": {
      "main": [
        [
          {
            "node": "Get results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get results": {
      "main": [
        [
          {
            "node": "Send to HubSpot",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send to Google Sheets",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
