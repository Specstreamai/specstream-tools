{
  "name": "@specstream/sdk",
  "version": "1.1.0",
  "description": "TypeScript client for SpecStream: finished lists from the live web, every row with its source, priced before anything runs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "specstream",
    "web-data",
    "live-web",
    "lead-lists",
    "enrichment",
    "monitoring",
    "mcp",
    "ai-agents",
    "sdk"
  ],
  "author": {
    "name": "SpecStream",
    "email": "support@specstream.ai",
    "url": "https://specstream.ai"
  },
  "license": "MIT",
  "homepage": "https://specstream.ai/docs/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Specstreamai/specstream-tools.git",
    "directory": "packages/sdk-ts"
  },
  "bugs": {
    "url": "https://github.com/Specstreamai/specstream-tools/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
